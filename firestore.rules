rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여넣고 "게시"하세요.
// ※ 아래 TEACHER_EMAIL@gmail.com 을 선생님 구글 계정 이메일로 바꾸세요. (소문자로)
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'TEACHER_EMAIL@gmail.com';
    }

    // 학생 신고서
    //  - 누구나 '새로 쓰기'만 가능 (읽기·수정·삭제 불가)
    //  - 정해진 항목만, 길이 제한을 지켜야 저장됨
    //  - 읽기·수정·삭제는 선생님 계정만
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['cls','name','occurredAt','place','what','action','reason','status','createdAt'])
                    && request.resource.data.keys().hasAll(
                         ['cls','name','occurredAt','place','what','action','reason','status','createdAt'])
                    && request.resource.data.cls is string
                    && request.resource.data.cls.size() > 0 && request.resource.data.cls.size() <= 20
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
                    && request.resource.data.occurredAt is string
                    && request.resource.data.occurredAt.size() > 0 && request.resource.data.occurredAt.size() <= 30
                    && request.resource.data.place is string
                    && request.resource.data.place.size() > 0 && request.resource.data.place.size() <= 60
                    && request.resource.data.what is string
                    && request.resource.data.what.size() > 0 && request.resource.data.what.size() <= 1000
                    && request.resource.data.action is string
                    && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 1000
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 600
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isTeacher();
    }

    // AI 분석 결과: 선생님만
    match /cases/{id} {
      allow read, write: if isTeacher();
    }
  }
}
